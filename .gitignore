# macOS
.DS_Store

# Claude Code machine-local settings (personal allow-list grants, absolute paths,
# and the configure --apply backup; never commit - the user owns every grant)
.claude/settings.local.json
.claude/*.bak
# The memory-MCP knowledge-graph store for this project (and the dated backups the
# server writes beside it, whose suffix is `.bak-<timestamp>` and so escapes the
# `*.bak` glob above). Machine-local session state, not repo content.
.claude/memory-*.json
.claude/*.bak-*
# Hookify rules are machine-local by convention (the `.local.md` suffix). Keep them out of
# git: a rule can encode a property of THIS machine rather than of the project (the lsof
# block, for instance, exists because lsof does not complete on the maintainer's Mac - a
# contributor whose lsof works would be blocked for no reason).
.claude/hookify.*.local.md

# Python
__pycache__/
*.pyc

# Ephemeral working state (durable design lives in DESIGN-*/PLAN-*/ROADMAP-*; these are
# session-scoped and follow the "no ephemeral docs in git" convention)
SESSION-STATE.md
CRITIQUE-*.md
# The orchestrate feedback mailbox is a machine-local symlink into ~/.claude/ (the GitHub
# ISSUE is the durable record); the mailbox + its dated archives are never committed.
orchestrate-session-feedback.md
orchestrate-session-feedback.archive-*.md
# Per-team / resource scratch that can surface in the repo root
profile.env

# Playwright MCP scratch (UAT screenshots land here; never commit)
.playwright-mcp/
